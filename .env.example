# dexSTASH settings. Copy to .env next to docker-compose.yml. Never commit .env.
# Everything is optional: a line starting with # uses the default shown. Remove the # to change one.
# (Notes after a value need Docker Compose v2, the `docker compose` command.)
# docs/configuration.md explains each one in more detail.

# --- Basics ---
# Your time zone, e.g. Europe/London (read on the first start; after that, change it in Data sources).
TZ=Etc/UTC
# Owner of the data folder: run `id` over SSH to see your numbers.
PUID=1000
PGID=1000
# APP_NAME=dexSTASH                         # the name shown everywhere
# DISPLAY_TZ=                               # time zone for the app only, if TZ must stay different

# --- First admin account (only read while there are no accounts) ---
# DEXSTASH_ADMIN_USER=misty                 # unset: the app prints a setup code in its log instead
# DEXSTASH_ADMIN_PASSWORD=                  # the first sign-in asks you to change it; then remove it here

# --- Security ---
# DEXSTASH_SECRET_KEY=                      # unset: made for you in data/secret_key (32+ characters if you set one)
# DEXSTASH_HTTPS_ONLY=1                     # 0 only for a plain-http test on your own network
# DEXSTASH_PROXY_IPS=172.18.0.5             # your proxy's address; unset: any private address

# --- Prices ---
# API keys (CardTrader, PriceCharting) are entered in the app: Data sources › Prices › API keys.
# DEXSTASH_TCGCSV=1                         # 0: no TCGplayer prices from TCGCSV
# DEXSTASH_EURO_RATE=1                      # 0: no exchange rates (Cardmarket prices and other currencies)

# --- Scanning ---
# DEXSTASH_SCANNER=separate                 # off | inside | separate; unset: the switch in Data sources › Scanning
# COMPOSE_PROFILES=scanner                  # with separate: starts the scanner container
# DEXSTASH_PICTURE_MODEL_URL=               # where Enhanced Search downloads its picture model
# DEXSTASH_APP_MEMORY=2g                    # the app container's memory cap; lower it (e.g. 1g) if you don't scan inside it

# --- Background work ---
# DEXSTASH_CARD_INDEX=1                     # 0: Find asks TCGdex for every search instead of its own card list
# DEXSTASH_PICTURE_CHECK=1                  # 0: no background check for missing card pictures
# DEXSTASH_TCGDEX_CACHE=1                   # 0: don't keep TCGdex replies for a week

# --- Image (DEPLOY.md › Using a release image) ---
# DEXSTASH_VERSION=latest                   # or 0.28 (newest 0.28.x), 0.28.0 (one release), pr-<number> (a test image)

# --- Network (your own Caddy) ---
# DEXSTASH_NETWORK=dexstash                 # the Docker network your Caddy is on
# DEXSTASH_NETWORK_EXTERNAL=false           # true when that network already exists

# --- Bundled Caddy (docker compose --profile caddy) ---
# DEXSTASH_DOMAIN=cards.example.com
# HTTP_PORT=80
# HTTPS_PORT=443

# --- Bundled DuckDNS updater (docker compose --profile duckdns) ---
# DUCKDNS_SUBDOMAIN=your-subdomain
# DUCKDNS_TOKEN=
