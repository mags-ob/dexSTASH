#!/bin/sh
# Runs the quick checks before a push, so a failure shows up here first. The pre-commit hook runs the scan.
# Turn hooks on with: git config core.hooksPath tools/hooks    Skip it once with: git push --no-verify
set -e
cd "$(git rev-parse --show-toplevel)"
py=python3
[ -x .venv/bin/python ] && py=.venv/bin/python
echo "pre-push: ruff"
"$py" -m ruff check . || { echo "Install ruff with: pip install ruff"; exit 1; }
echo "pre-push: core rules"
"$py" tools/check_rules.py
if command -v gitleaks >/dev/null 2>&1; then
  echo "pre-push: gitleaks"
  gitleaks git --no-banner --redact .
fi
echo "pre-push: tests"
"$py" -m pytest -q
